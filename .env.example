# Target
SIAKAD_BASE_URL=https://siakad.polinema.ac.id
HEADLESS=true

# Kredensial untuk pengujian fitur setelah login.
# Gunakan akun uji, JANGAN akun pribadi dengan data sensitif.
# Selama dua variabel ini kosong, seluruh test di tests/auth akan di-skip
# dan hanya halaman publik yang diuji.
SIAKAD_USERNAME=
SIAKAD_PASSWORD=

# Opsional: batasi pengujian menu ke sebagian rute (dipisah koma).
# Contoh: SIAKAD_MENU_FILTER=krs,khs,jadwal
SIAKAD_MENU_FILTER=

# Opsional: jumlah maksimum menu yang dikunjungi saat crawl (default 60).
SIAKAD_MAX_MENUS=60

# Opsional: jeda antar navigasi dalam milidetik agar server tidak terbebani.
SIAKAD_NAV_DELAY_MS=400
